# Files for the source distribution. The wheel contains only the decay_engine
# package; the sdist additionally carries the tests, docs, and example so the
# suite can be run from an unpacked release.
include LICENSE
include README.md
include STATUS.md
include MANIFEST.in
recursive-include docs *.md
recursive-include tests *.py
recursive-include examples *.py

# Never ship local environment or build leftovers.
global-exclude *.py[cod]
global-exclude .env .env.*
prune .venv
prune dist
prune build
