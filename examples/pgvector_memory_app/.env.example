# Optional. Every value below is already the compose default, so the demo runs
# with no .env at all. Copy this to .env only to override something.
#
#   cp .env.example .env

POSTGRES_DB=decay_demo
POSTGRES_USER=decay
POSTGRES_PASSWORD=decay

# Host port for poking at the database with psql. The app does not use it.
# Chosen to avoid clashing with the repository-root compose stack.
POSTGRES_PORT=55433
